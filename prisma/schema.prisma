generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceProduct {
  B2B_SALE
  PETCLINIC_OPERATING
  PETCLINIC_ESSENTIAL
  EXTERNAL_CONNECTOR
}

enum InstallationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ERROR
}

enum CredentialStatus {
  ACTIVE
  ROTATING_OUT
  REVOKED
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  WITHDRAWN
}

enum CareJobStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  OPTED_OUT
  ACCOUNT_RESTRICTED
  RECIPIENT_NOT_FOUND
}

enum ChannelKind {
  MOCK
  PERSONAL_ZALO
  ZNS
}

enum ZaloAccountStatus {
  PENDING_LOGIN
  CONNECTING
  CONNECTED
  RELOGIN_REQUIRED
  PAUSED
  RATE_LIMITED
  RESTRICTED
  DISCONNECTED
  ERROR
  REVOKED
}

// RESERVED → IN_FLIGHT → SENT | REJECTED_BEFORE_SEND (certainly not sent) | UNKNOWN (outcome not known).
enum DeliveryAttemptStatus {
  RESERVED
  IN_FLIGHT
  SENT
  REJECTED_BEFORE_SEND
  UNKNOWN
}

model Installation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  sourceProduct SourceProduct
  status InstallationStatus @default(PENDING)
  scopes String[]
  callbackUrl String?
  sourceVerifyUrl String?
  callbackSecretEnc String?
  dailyQuota Int @default(30)
  quietHoursStart String @default("21:00") @db.VarChar(5)
  quietHoursEnd String @default("08:00") @db.VarChar(5)
  timezone String @default("Asia/Ho_Chi_Minh")
  expiresAt DateTime?
  lastConnectedAt DateTime?
  lastError String? @db.VarChar(500)
  paused Boolean @default(false)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  credentials ApiCredential[]
  nonces RequestNonce[]
  jobs CareJob[]
  optOuts OptOut[]
  zaloAccounts ZaloAccount[]
  routingRules ZaloRoutingRule[]
  deliveryAttempts DeliveryAttempt[]
  webhookDeliveries WebhookDelivery[]
  auditLogs AuditLog[]
  templates MessageTemplate[]
  petclinicConnection PetclinicConnection?
  sourceConnection SourceConnection?
  @@unique([tenantId, sourceProduct])
  @@unique([id, tenantId])
  @@index([status, expiresAt])
}

model PetclinicConnection {
  id String @id @default(uuid()) @db.Uuid
  installationId String @unique @db.Uuid
  apiBaseUrl String
  apiTokenEnc String?
  apiTenantId String @db.VarChar(160)
  allowedBranchIds String[]
  sourceProduct SourceProduct @default(PETCLINIC_OPERATING)
  credentialKeyId String? @db.VarChar(80)
  credentialExpiresAt DateTime?
  sourceUpdatedAt DateTime?
  sourceInstallationId String? @unique @db.Uuid
  sourceRevision Int?
  contractVersion Int @default(1)
  pilotAllowedPhoneHashes String[]
  appointmentsPath String @default("/clinic-service/api/v1/clinic/appointments")
  reminderLeadMinutes Int @default(1440)
  active Boolean @default(false)
  lastSyncAt DateTime?
  lastSyncStatus String? @db.VarChar(40)
  lastError String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

model ControlNonce {
  clientId String @db.VarChar(80)
  nonce String @db.VarChar(80)
  seenAt DateTime @default(now())
  @@id([clientId, nonce])
  @@index([seenAt])
}

model ApiCredential {
  id String @id @default(uuid()) @db.Uuid
  installationId String @db.Uuid
  clientId String @unique @db.VarChar(80)
  secretHash String @db.VarChar(64)
  secretLast4 String @db.VarChar(8)
  // Standalone PC: the HMAC signing key (SHA-256 of the secret) encrypted at rest; secretHash then only
  // holds SHA-256(signingKey) as a fingerprint and is never used as a key.
  signingKeyEnc String?
  status CredentialStatus @default(ACTIVE)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@index([installationId, status])
}

model RequestNonce {
  installationId String @db.Uuid
  nonce String @db.VarChar(80)
  seenAt DateTime @default(now())
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@id([installationId, nonce])
  @@index([seenAt])
}

model CareJob {
  id String @id @default(uuid()) @db.Uuid
  installationId String @db.Uuid
  idempotencyKey String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  externalReferenceId String @db.VarChar(160)
  sourceProduct SourceProduct
  eventType String @db.VarChar(80)
  recipientNameEnc String
  phoneEnc String
  phoneHash String @db.VarChar(64)
  templateCode String @db.VarChar(100)
  templateVariables Json
  scheduledAt DateTime
  sourceAppointmentAt DateTime?
  sourceRevision String? @db.VarChar(100)
  consentStatus ConsentStatus
  status CareJobStatus @default(QUEUED)
  attempts Int @default(0)
  nextAttemptAt DateTime?
  lockedAt DateTime?
  lockedBy String? @db.VarChar(100)
  providerMessageId String? @db.VarChar(160)
  failureCode String? @db.VarChar(80)
  failureReason String? @db.VarChar(500)
  branchId String? @db.VarChar(80)
  // PC edition: Platform source entry (PETCLINIC | B2B_SALE | EXTERNAL) this job was licensed under.
  licenseSource String? @db.VarChar(20)
  selectedZaloAccountId String? @db.Uuid
  selectedChannel ChannelKind?
  sentAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  webhookDeliveries WebhookDelivery[]
  selectedZaloAccount ZaloAccount? @relation(fields: [selectedZaloAccountId], references: [id], onDelete: SetNull)
  deliveryAttempts DeliveryAttempt[]
  @@unique([installationId, idempotencyKey])
  @@index([status, scheduledAt, nextAttemptAt])
  @@index([installationId, externalReferenceId])
}

model OptOut {
  installationId String @db.Uuid
  phoneHash String @db.VarChar(64)
  source String @db.VarChar(80)
  reason String? @db.VarChar(300)
  createdAt DateTime @default(now())
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@id([installationId, phoneHash])
}

// A Zalo sending account owned by a tenant (Platform tenant UUID, same value as Installation.tenantId).
// installationId is only the legacy/control-plane provisioning link; routing uses ZaloRoutingRule.
model ZaloAccount {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  installationId   String?           @db.Uuid
  channel          ChannelKind
  displayName      String?           @db.VarChar(160)
  phoneEnc         String?
  phoneMasked      String?           @db.VarChar(20)
  status           ZaloAccountStatus @default(PENDING_LOGIN)
  paused           Boolean           @default(false)
  pausedAt         DateTime?
  pausedBy         String?           @db.VarChar(160)
  priority         Int               @default(100)
  isDefault        Boolean           @default(false)
  dailyQuota       Int               @default(30)
  timezone         String            @default("Asia/Ho_Chi_Minh") @db.VarChar(60)
  // Sender capabilities negotiated with the operator (contractVersion, idempotentSend, recipientPreflight, qrLogin).
  capabilities     Json              @default("{}")
  sessionVersion   Int               @default(0)
  credentialEnc    String?
  senderBaseUrl    String?
  senderClientId   String?           @db.VarChar(100)
  dailySentCount   Int               @default(0)
  dailyCountDate   String?           @db.VarChar(10)
  lastConnectedAt  DateTime?
  lastActiveAt     DateTime?
  lastError        String?           @db.VarChar(500)
  // Thời điểm (occurredAt) của health event sender mới nhất đã áp dụng — khoá thứ tự cho cập nhật có điều kiện.
  lastSenderEventAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  installation     Installation?     @relation(fields: [installationId], references: [id], onDelete: SetNull)
  routingRules     ZaloRoutingRule[]
  deliveryAttempts DeliveryAttempt[]
  selectedForJobs  CareJob[]
  healthEvents     SenderHealthEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

// Account affinity: most specific match wins (branch > installation > tenant default), then priority.
model ZaloRoutingRule {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  zaloAccountId  String        @db.Uuid
  installationId String?       @db.Uuid
  branchId       String?       @db.VarChar(80)
  eventType      String?       @db.VarChar(80)
  priority       Int           @default(100)
  active         Boolean       @default(true)
  createdBy      String?       @db.VarChar(160)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  account        ZaloAccount   @relation(fields: [zaloAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  installation   Installation? @relation(fields: [installationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, active])
}

// One row per send attempt. id is the deliveryAttemptId / sender idempotency key.
model DeliveryAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  careJobId         String                @db.Uuid
  installationId    String                @db.Uuid
  zaloAccountId     String                @db.Uuid
  attemptNumber     Int
  requestHash       String                @db.VarChar(64)
  status            DeliveryAttemptStatus @default(RESERVED)
  outcomeCode       String?               @db.VarChar(80)
  providerMessageId String?               @db.VarChar(160)
  // Reserved quota scopes [{scope, scopeId, day, limit}] released only on a certain NOT_SENT.
  quotaScopes       Json
  quotaReleased     Boolean               @default(false)
  sendCount         Int                   @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime              @default(now())
  careJob           CareJob               @relation(fields: [careJobId], references: [id], onDelete: Cascade)
  account           ZaloAccount           @relation(fields: [zaloAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  installation      Installation          @relation(fields: [installationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([careJobId, attemptNumber])
  @@index([zaloAccountId, createdAt])
}

// Atomic per-day reservations. scope: TENANT | INSTALLATION | ACCOUNT. day is YYYY-MM-DD in the scope timezone.
model DeliveryQuotaCounter {
  scope     String   @db.VarChar(16)
  scopeId   String   @db.Uuid
  day       String   @db.VarChar(10)
  used      Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([scope, scopeId, day])
}

model MessageTemplate {
  id String @id @default(uuid()) @db.Uuid
  installationId String @db.Uuid
  code String @db.VarChar(100)
  body String @db.VarChar(2000)
  allowedVariables String[]
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@unique([installationId, code])
}

model WebhookDelivery {
  id String @id @default(uuid()) @db.Uuid
  installationId String @db.Uuid
  careJobId String @db.Uuid
  sequence Int
  status CareJobStatus
  attempts Int @default(0)
  nextAttemptAt DateTime?
  deliveredAt DateTime?
  lastHttpStatus Int?
  lastError String? @db.VarChar(500)
  createdAt DateTime @default(now())
  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  careJob CareJob @relation(fields: [careJobId], references: [id], onDelete: Cascade)
  @@unique([careJobId, sequence])
  @@index([nextAttemptAt, deliveredAt])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  installationId String? @db.Uuid
  tenantId String? @db.Uuid
  actorType String @db.VarChar(40)
  actorId String? @db.VarChar(160)
  action String @db.VarChar(120)
  targetType String? @db.VarChar(80)
  targetId String? @db.VarChar(160)
  result String @db.VarChar(40)
  reason String? @db.VarChar(500)
  metadata Json?
  createdAt DateTime @default(now())
  installation Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  @@index([installationId, createdAt])
  @@index([tenantId, createdAt])
}

model SystemSetting {
  key String @id @db.VarChar(100)
  value Json
  updatedBy String @db.VarChar(160)
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  username String @unique @db.VarChar(80)
  passwordHash String @db.VarChar(240)
  active Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// VETCLINIC CRM (customer-facing, tenant-scoped). Platform Admin is the source of truth for
// tenant, user, entitlement and installation; these tables only cache what Platform sent over a
// signed channel. Tenant scope for every CRM request comes from CrmSession, never from the client.
// ---------------------------------------------------------------------------

model CrmTenant {
  platformTenantId        String       @id @db.Uuid
  displayName             String?      @db.VarChar(200)
  // Platform installation of product CUSTOMER_CARE_CRM for this tenant (credential used for
  // token-exchange/session-check). Secret is encrypted at rest and never returned by any API.
  platformInstallationId  String?      @db.Uuid
  platformClientId        String?      @unique @db.VarChar(100)
  platformClientSecretEnc String?
  callbackBaseUrl         String?      @db.VarChar(300)
  platformApiBaseUrl      String?      @db.VarChar(300)
  b2bSourceStatus         String       @default("NOT_GRANTED") @db.VarChar(20)
  b2bSourceUpdatedAt      DateTime?
  installationStatus      String       @default("PENDING") @db.VarChar(20)
  entitlementStatus       String       @default("UNKNOWN") @db.VarChar(20)
  planCode                String?      @db.VarChar(64)
  limits                  Json?
  features                Json?
  entitlementStartsAt     DateTime?
  entitlementExpiresAt    DateTime?
  entitlementUpdatedAt    DateTime?
  // Tenant-wide daily cap chosen by the tenant; effective limit is min(this, plan limits.dailyQuotaMax).
  tenantDailyQuota        Int?
  timezone                String       @default("Asia/Ho_Chi_Minh") @db.VarChar(60)
  autoSendPaused          Boolean      @default(false)
  autoSendPausedAt        DateTime?
  autoSendPausedBy        String?      @db.VarChar(160)
  // Set by Platform `tenant.deletion_requested`; locks login, new jobs and sending (held, not cancelled).
  deletionRequestId       String?      @db.Uuid
  deletionRequestedAt     DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  sessions                CrmSession[]
  localUsers              LocalUser[]
}

// Deletion ledger. No FK to CrmTenant on purpose: it must survive the purge so a Platform retry with
// the same requestId returns the same result. Holds no personal data.
model CrmTenantDeletion {
  requestId        String    @id @db.Uuid
  platformTenantId String    @db.Uuid
  status           String    @db.VarChar(20)
  requestedAt      DateTime
  scheduledPurgeAt DateTime
  retentionDays    Int
  exportChecksum   String?   @db.VarChar(64)
  cancelledAt      DateTime?
  purgeStartedAt   DateTime?
  completedAt      DateTime?
  purgeAttempts    Int       @default(0)
  deletedCounts    Json?
  errorCode        String?   @db.VarChar(80)
  errorMessage     String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([platformTenantId])
}

model CrmSession {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String    @unique @db.VarChar(64)
  platformTenantId String    @db.Uuid
  platformUserId   String    @db.Uuid
  productCode      String    @db.VarChar(40)
  roles            String[]
  displayName      String?   @db.VarChar(200)
  username         String?   @db.VarChar(160)
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  lastCheckedAt    DateTime  @default(now())
  checkGraceUntil  DateTime?
  revokedAt        DateTime?
  revokeReason     String?   @db.VarChar(80)
  userAgent        String?   @db.VarChar(300)
  tenant           CrmTenant @relation(fields: [platformTenantId], references: [platformTenantId], onDelete: Cascade)

  @@index([platformTenantId, platformUserId])
  @@index([expiresAt])
}

model CrmSsoTokenReplay {
  jti              String   @id @db.VarChar(100)
  platformTenantId String   @db.Uuid
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([expiresAt])
}

model PlatformEvent {
  eventId          String    @id @db.VarChar(80)
  type             String    @db.VarChar(60)
  platformTenantId String?   @db.Uuid
  occurredAt       DateTime?
  receivedAt       DateTime  @default(now())
  result           String    @db.VarChar(40)
  payloadHash      String?   @db.Char(64)

  @@index([platformTenantId, receivedAt])
}

// Health callback sender → Gateway (contract v2). eventId là khóa idempotent; chỉ sự kiện mới hơn mới được áp dụng.
model SenderHealthEvent {
  eventId       String      @id @db.Uuid
  tenantId      String      @db.Uuid
  zaloAccountId String      @db.Uuid
  status        String      @db.VarChar(30)
  reason        String?     @db.VarChar(80)
  occurredAt    DateTime
  result        String      @db.VarChar(20)
  receivedAt    DateTime    @default(now())
  account       ZaloAccount @relation(fields: [zaloAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([zaloAccountId, occurredAt])
}

// ---------------------------------------------------------------------------
// Standalone PC Edition (DEPLOYMENT_MODE=standalone). No Platform: one business per PC, local users,
// self-issued API credentials. These tables stay empty in the VPS/Platform deployment.
// ---------------------------------------------------------------------------

// Singleton (id is always 1, enforced by a CHECK constraint): the PC has exactly one business.
model StandaloneInstance {
  id        Int      @id @default(1)
  tenantId  String   @unique @db.Uuid
  createdAt DateTime @default(now())
}

model LocalUser {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  username          String    @unique @db.VarChar(80)
  displayName       String?   @db.VarChar(200)
  passwordHash      String    @db.VarChar(300)
  role              String    @db.VarChar(20)
  active            Boolean   @default(true)
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdBy         String?   @db.VarChar(160)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            CrmTenant @relation(fields: [tenantId], references: [platformTenantId], onDelete: Cascade)

  @@index([tenantId])
}

// Generic source connector ("VETCLINIC Source Connector v1"). CRM signs every request with the
// installation's self-issued credential (HMAC); no bearer token is stored.
model SourceConnection {
  id                  String       @id @default(uuid()) @db.Uuid
  installationId      String       @unique @db.Uuid
  apiBaseUrl          String       @db.VarChar(300)
  appointmentsEnabled Boolean      @default(true)
  receivablesEnabled  Boolean      @default(false)
  allowedBranchIds    String[]
  reminderLeadMinutes Int          @default(1440)
  active              Boolean      @default(false)
  lastSyncAt          DateTime?
  lastSyncStatus      String?      @db.VarChar(40)
  lastError           String?      @db.VarChar(500)
  // Which Platform source entry licenses this connector: PETCLINIC | B2B_SALE | EXTERNAL (NULL = not chosen yet).
  sourceKind          String?      @db.VarChar(20)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  installation        Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Platform Device Agent (standalone PC edition). Platform Admin is only the control plane (plan, one-time activation,
// device, branch scope, limits). Never holds: source API credentials, Zalo sessions, customer data, recovery key.
// The activation code itself is never stored.
// ---------------------------------------------------------------------------

// One row today (id pinned to 1 by a CHECK constraint); deviceId is unique so several devices can be supported later.
model PlatformDeviceRegistration {
  id                     Int       @id @default(1)
  deviceId               String    @unique @db.Uuid
  // Ed25519 public key (SPKI PEM). The private key is AES-GCM encrypted with DEVICE_KEY_ENC_KEY, a machine-only secret
  // from the DPAPI store that is deliberately NOT in the backup key bundle: a restore on another PC must re-pair.
  devicePublicKey        String
  devicePrivateKeyEnc    String
  // PENDING (redeem sent, no answer yet) | ACTIVE | REVOKED | UNPAIRED
  status                 String    @db.VarChar(20)
  // Redeem idempotency key for the code being activated (kept across failed retries of the same code).
  pendingRequestId       String?   @db.Uuid
  // HMAC(machine key, code) of that code, only to recognise a retry; cleared once ACTIVE. The code is never stored.
  pendingCodeHash        String?   @db.VarChar(64)
  // Short lease: at most one activation runs at a time.
  activationLockedUntil  DateTime?
  // True forever once the PC was paired: it never falls back to "not activated" (no bypass either).
  everPaired             Boolean   @default(false)
  // Pending attempt: last failure code, and whether it may already be bound on Platform (then only the same code may
  // be retried, and an expired code needs the confirmed recovery). Never reset automatically.
  activationError        String?   @db.VarChar(80)
  activationMaybeBound   Boolean   @default(false)
  platformInstallationId String?   @db.VarChar(100)
  platformTenantId       String?   @db.VarChar(100)
  businessName           String?   @db.VarChar(200)
  pairedAt               DateTime?
  lastValidatedAt        DateTime?
  lastConfigRevision     Int       @default(0)
  entitlementValidUntil  DateTime?
  offlineGraceUntil      DateTime?
  lastSyncAt             DateTime?
  lastSyncError          String?   @db.VarChar(80)
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Signed desired configuration received from Platform. Only verified documents are stored; revision is strictly increasing.
model PlatformDesiredConfiguration {
  id          String    @id @default(uuid()) @db.Uuid
  deviceId    String    @db.Uuid
  revision    Int
  payload     Json
  payloadHash String    @db.VarChar(64)
  signature   String    @db.VarChar(200)
  keyId       String    @db.VarChar(80)
  expiresAt   DateTime
  receivedAt  DateTime  @default(now())
  appliedAt   DateTime?
  // APPLIED | FAILED
  applyStatus String    @db.VarChar(20)
  applyError  String?   @db.VarChar(80)

  @@unique([deviceId, revision])
  @@index([deviceId, appliedAt])
}
