PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgresql://care_gateway:change_me_local_only@127.0.0.1:5441/customer_care_gateway?schema=public
POSTGRES_PASSWORD=replace_with_32_plus_random_bytes
PLATFORM_CONTROL_CLIENT_ID=platform-admin
PLATFORM_CONTROL_SECRET=replace_with_32_plus_random_bytes
PHONE_HASH_PEPPER=replace_with_32_plus_random_bytes
DATA_ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
MOCK_ADAPTER_ENABLED=true
WORKER_ENABLED=false
LOCAL_SENDER_SIGNING_KEY=replace_with_32_plus_random_bytes_shared_with_private_sender

# Operating PETCLINIC pilot. Keep these server-side; never expose them to the browser.
PETCLINIC_GATEWAY_TENANT_UUID=
PETCLINIC_API_BASE=https://api.mpets.vn
PETCLINIC_API_TOKEN=
PETCLINIC_API_TENANT_ID=
PETCLINIC_ALLOWED_BRANCH_IDS=
PETCLINIC_PILOT_ALLOWED_PHONES=
PETCLINIC_REMINDER_LEAD_MINUTES=1440
# Admin UI. Store a scrypt hash, never a plaintext password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$replace_with_salt$replace_with_128_hex_char_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_SETUP_TOKEN_HASH=replace_with_sha256_of_one_time_setup_token

# VETCLINIC CRM (customer-facing, tenant-scoped). Placeholders only; real values come from the secret channel.
# Session secret must differ from ADMIN_SESSION_SECRET (enforced).
CRM_SESSION_SECRET=replace_with_at_least_32_random_characters
CRM_SESSION_TTL_HOURS=8
CRM_ENTITLEMENT_RECHECK_SECONDS=60
CRM_PUBLIC_ORIGIN=https://crm.vetclinic.vn
# Platform (source of truth for tenant/user/entitlement). JWKS defaults to PLATFORM_API_BASE_URL/platform-auth/.well-known/jwks.json
PLATFORM_WEB_ORIGIN=https://platform.vetclinic.vn
PLATFORM_API_BASE_URL=https://platform.vetclinic.vn/api
PLATFORM_AUTH_ISSUER=vetclinic.vn-platform
PLATFORM_JWKS_URL=
# Shared HMAC secret for signed Platform -> CRM events (installation/subscription/user access). Not reused elsewhere.
CRM_PLATFORM_EVENTS_SECRET=replace_with_32_plus_random_bytes
# Local development only: allow http://127.0.0.1 Platform URLs (ignored when NODE_ENV=production).
PLATFORM_ALLOW_HTTP_LOCAL=false

# Sender Zalo v2 (private, server-to-server). Khi đặt đủ 3 biến, Gateway TỰ đăng ký mỗi account Zalo mới
# sang sender (POST /internal/v1/accounts/:id/register có ký). Client + khoá do người vận hành sender cấp MỘT LẦN
# (scripts/gateway-v2-admin.ts register-client ... <healthCallbackUrl>). Health callback của sender gọi về
# POST /api/v1/channel/accounts/:id/health (ký bằng cùng khoá). Để trống = không tự đăng ký.
SENDER_V2_BASE_URL=
SENDER_V2_CLIENT_ID=
SENDER_V2_SIGNING_KEY=
