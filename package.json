{
  "name": "customer-care-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "nest build",
    "build:web": "npm --prefix web run build",
    "web:install": "npm --prefix web ci",
    "dev:web": "npm --prefix web run dev",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand --runTestsByPath test/tenant-isolation.integration.spec.ts test/worker-flow.integration.spec.ts test/http-auth.integration.spec.ts test/petclinic-sync.integration.spec.ts test/crm-tenant.integration.spec.ts test/multi-zalo.integration.spec.ts test/sender-v2-gateway.integration.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "pilot:petclinic:configure": "ts-node scripts/configure-petclinic-pilot.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/client": "6.12.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.12.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "supertest": "7.1.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
